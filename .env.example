# Copie para .env (que não vai para o git). O Makefile carrega estas variáveis.
# Só é necessário para publicar os dados processados no GCP (load.destination: bigquery | gcs).

# Projeto do GCP usado pelo BigQuery/Storage (alternativa a load.bigquery.project no config.yaml)
GCP_PROJECT=

# Bucket do Cloud Storage (alternativa a load.gcs.bucket no config.yaml)
GCS_BUCKET=

# Autenticação: prefira `gcloud auth application-default login`.
# Para conta de serviço, aponte para a chave JSON (fora do repositório):
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/chave.json

# Outro arquivo de configuração (opcional)
# CONFIG_PATH=configs/config.yaml
